table customers_and_payments
	lineageTag: f6900b5d-0812-48c3-87a8-b1a5635eb806

	measure 'Customer Orders' = DISTINCTCOUNT('customers_and_payments'[order_id])
		formatString: #,##0
		displayFolder: Customer KPIs
		lineageTag: 5afe8721-c15c-4b3e-953a-57d9cd07bacc

	measure 'Unique Customers' = DISTINCTCOUNT('customers_and_payments'[customer_unique_id])
		formatString: #,##0
		displayFolder: Customer KPIs
		lineageTag: e1d972d9-ac5d-41d5-a377-030ee14ec1b0

	measure 'Repeat Customers' =
			CALCULATE(
				DISTINCTCOUNT('customers_and_payments'[customer_unique_id]),
				'customers_and_payments'[is_repeat_customer] = TRUE()
			)
		formatString: #,##0
		displayFolder: Customer KPIs
		lineageTag: 19c3a418-e05f-4ad4-8ee6-b0bc865667fa

	measure 'Repeat Customer Rate' = DIVIDE([Repeat Customers], [Unique Customers])
		formatString: 0.0%
		displayFolder: Customer KPIs
		lineageTag: 4ac75034-65e9-4145-8148-40d3c7e65fd6

	measure 'Repeat Orders' =
			CALCULATE(
				DISTINCTCOUNT('customers_and_payments'[order_id]),
				'customers_and_payments'[is_repeat_order] = TRUE()
			)
		formatString: #,##0
		displayFolder: Customer KPIs
		lineageTag: 836b8bd6-4dec-4d2a-9496-baa39b91a90e

	measure 'Repeat Order Rate' = DIVIDE([Repeat Orders], [Customer Orders])
		formatString: 0.0%
		displayFolder: Customer KPIs
		lineageTag: d2720e9e-6003-446c-8090-74c1b0f5ceb6

	measure 'Total Payment Value' = SUM('customers_and_payments'[total_payment_value])
		formatString: R$ #,##0
		displayFolder: Payment KPIs
		lineageTag: aadf8e57-9801-4d2d-873c-0778f9a89e25

	measure 'Average Payment per Order' = DIVIDE([Total Payment Value], [Customer Orders])
		formatString: R$ #,##0.00
		displayFolder: Payment KPIs
		lineageTag: f3e836b6-f1cd-458c-95ec-c44087505512

	measure 'Average Installments' = AVERAGE('customers_and_payments'[max_installments])
		formatString: 0.0
		displayFolder: Payment KPIs
		lineageTag: 8f235494-80ea-450a-b0d4-3d5cd6eea460

	measure 'Top 10 Customer State Value' =
			VAR StateRank =
				RANKX(
					ALLSELECTED('customers_and_payments'[customer_state]),
					[Total Payment Value],
					,
					DESC,
					DENSE
				)
			RETURN
				IF(StateRank <= 10, [Total Payment Value])
		formatString: R$ #,##0
		displayFolder: Ranking Measures
		lineageTag: ed360582-0ec4-4f7c-9039-0a4d35582e63

	measure 'GMV Trend - Complete Months' =
			
			VAR CurrentMonth =
			    MAX(dim_dates[month])
			
			VAR LastValidOrderDate =
			    CALCULATE(
			        MAX(sales_and_orders[date_day]),
			        REMOVEFILTERS(dim_dates),
			        sales_and_orders[delivered_orders] > 0
			    )
			
			VAR LastValidMonth =
			    DATE(
			        YEAR(LastValidOrderDate),
			        MONTH(LastValidOrderDate),
			        1
			    )
			
			RETURN
			    IF(
			        CurrentMonth <= LastValidMonth,
			        [Delivered GMV],
			        BLANK()
			    )
		lineageTag: 5fffdcf3-d5d7-4670-b525-baac59d550ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

